// Temporal antialiasing resolve — ported from Bevy's TAA
// (crates/bevy_anti_alias/src/taa/taa.wesl, MIT / Apache-2.0), itself after
// Karis 2014 ("High Quality Temporal Supersampling"), Salvi 2016 (variance
// clipping), Playdead's YCoCg helpers (MIT), and Hoppe's confidence; the
// history filter is Godot's (taa_resolve.glsl, MIT: Panos Karabelas' TAA)
// 9-tap Catmull-Rom after MJP. Differences from Bevy:
// - motion: the velocity target where a moving mesh drew its motion
//   (motion.vert), else the depth reprojected through the camera's motion
//   (u_reproject) — exact for everything static, no motion-vector pass for
//   it;
// - the full 9-tap Catmull-Rom (Bevy's 5 taps drop the corners and soften
//   the history a little each frame, which shows as blur while turning);
// - the tonemap for filtering, clipping and blending sees the exposed
//   color (the display's exposure: Bevy's targets are pre-exposed);
// - the history holds linear premultiplied radiance and the confidence in
//   its alpha; coverage alpha is read from the current frame by the
//   display;
// - a reactive mask, generated as FSR2's helper does (AMD FidelityFX FSR2,
//   ffx_fsr2_autogen_reactive_pass.glsl, MIT, with its sample's defaults):
//   where transmissive or transparent meshes changed the opaque scene, the
//   motion found is what's behind them, so the history counts for less —
//   while the pixel moves, or anywhere while one of them moved;
// - Godot's velocity disocclusion (get_factor_disocclusion, after
//   elopezr's "Temporal AA and the quest for the Holy Trail"): where the
//   motion differs from what the history's pixel moved by last frame, the
//   history belongs to another surface (just uncovered), and counts for
//   less. Each resolve keeps its motion per pixel for the next.
// Needs nothing from the scene prelude.

precision highp float;
precision highp int;
precision highp sampler2D;

in vec2 v_ndc;
layout(location = 0) out vec4 frag_color; // rgb linear premultiplied, a confidence
layout(location = 1) out vec4 frag_motion; // xy the motion used (uv now − uv then)

uniform sampler2D u_current;  // this frame (jittered), linear HDR
uniform sampler2D u_history;  // the last resolve
uniform sampler2D u_prev_motion; // its motion per pixel
uniform sampler2D u_depth;    // this frame's depth
uniform sampler2D u_velocity; // moving meshes: uv now − uv then (else > 100)
uniform mat4 u_reproject;     // clip now (unjittered) → clip last frame
uniform vec4 u_taa;           // x 1: reset, y 1: reverse-Z, z 1: u_velocity
                              // drawn this frame, w exposure
uniform vec2 u_jitter;        // this frame's projection offset (NDC)
uniform sampler2D u_opaque;   // the opaque scene alone, this frame
uniform vec2 u_reactive;      // x 1: u_opaque copied this frame, y 1: a
                              // transmissive or transparent mesh moved

// Lower = more history: chosen empirically by Bevy.
const float DEFAULT_HISTORY_BLEND_RATE = 0.1;
const float MIN_HISTORY_BLEND_RATE = 0.015;

// FSR2's autogenerated reactivity (its sample's settings: tonemapped, max
// of components, scale 1, threshold 0.2) with a binary value of 0.5, not
// the sample's 0.9: through refracting glass in motion 0.9 showed the
// jittered frame almost raw (swimming), 0 let the history lag; measured
// on DragonDispersion, 0.5 deviates least from MSAA in both.
// Godot's disocclusion: (change in motion, texels − threshold) × scale is
// added to the blend factor.
const float DISOCCLUSION_THRESHOLD = 2.5;
const float DISOCCLUSION_SCALE = 0.01;

const float REACTIVE_SCALE = 1.0;
const float REACTIVE_THRESHOLD = 0.2;
const float REACTIVE_BINARY = 0.5;
// How much wider the clip box is through glass while still (see below).
const float GLASS_STILL_BOX = 3.0;

float max3(vec3 c) { return max(c.r, max(c.g, c.b)); }
// Karis' reversible tonemap, of the exposed color.
vec3 tonemap(vec3 c) { c *= u_taa.w; return c / (max3(c) + 1.0); }
vec3 reverse_tonemap(vec3 c) { return c / max(1.0 - max3(c), 1e-4) / u_taa.w; }

vec3 rgb_to_ycocg(vec3 c) {
    return vec3(c.r / 4.0 + c.g / 2.0 + c.b / 4.0,
                c.r / 2.0 - c.b / 2.0,
                -c.r / 4.0 + c.g / 2.0 - c.b / 4.0);
}

vec3 ycocg_to_rgb(vec3 c) {
    return clamp(vec3(c.x + c.y - c.z, c.x + c.z, c.x - c.y - c.z), 0.0, 1.0);
}

vec3 clip_towards_aabb_center(vec3 history, vec3 lo, vec3 hi) {
    vec3 p = 0.5 * (hi + lo);
    vec3 e = 0.5 * (hi - lo) + 1e-8;
    vec3 v = history - p;
    float m = max3(abs(v / e));
    return m > 1.0 ? p + v / m : history;
}

vec3 sample_history(vec2 uv) {
    return tonemap(textureLod(u_history, uv, 0.0).rgb);
}

vec3 sample_current(ivec2 p) {
    ivec2 size = textureSize(u_current, 0);
    return rgb_to_ycocg(tonemap(texelFetch(u_current, clamp(p, ivec2(0), size - 1), 0).rgb));
}

float depth_at(vec2 uv) {
    return textureLod(u_depth, uv, 0.0).r;
}

// The history at uv: Catmull-Rom over 4×4 texels in 9 bilinear taps (MJP,
// via Godot's sample_catmull_rom_9).
vec3 history_catmull_rom(vec2 uv, vec2 size) {
    vec2 sample_pos = uv * size;
    vec2 tex_pos1 = floor(sample_pos - 0.5) + 0.5;
    vec2 f = sample_pos - tex_pos1;
    vec2 w0 = f * (-0.5 + f * (1.0 - 0.5 * f));
    vec2 w1 = 1.0 + f * f * (-2.5 + 1.5 * f);
    vec2 w2 = f * (0.5 + f * (2.0 - 1.5 * f));
    vec2 w3 = f * f * (-0.5 + 0.5 * f);
    vec2 w12 = w1 + w2;
    vec2 offset12 = w2 / w12;
    vec2 p0 = (tex_pos1 - 1.0) / size;
    vec2 p3 = (tex_pos1 + 2.0) / size;
    vec2 p12 = (tex_pos1 + offset12) / size;
    vec3 r = sample_history(vec2(p0.x, p0.y)) * w0.x * w0.y;
    r += sample_history(vec2(p12.x, p0.y)) * w12.x * w0.y;
    r += sample_history(vec2(p3.x, p0.y)) * w3.x * w0.y;
    r += sample_history(vec2(p0.x, p12.y)) * w0.x * w12.y;
    r += sample_history(vec2(p12.x, p12.y)) * w12.x * w12.y;
    r += sample_history(vec2(p3.x, p12.y)) * w3.x * w12.y;
    r += sample_history(vec2(p0.x, p3.y)) * w0.x * w3.y;
    r += sample_history(vec2(p12.x, p3.y)) * w12.x * w3.y;
    r += sample_history(vec2(p3.x, p3.y)) * w3.x * w3.y;
    return max(r, 0.0);
}

void main() {
    vec2 size = vec2(textureSize(u_current, 0));
    vec2 texel = 1.0 / size;
    vec2 uv = gl_FragCoord.xy * texel;
    ivec2 px = ivec2(gl_FragCoord.xy);
    vec4 original = texelFetch(u_current, px, 0);
    if (u_taa.x > 0.5) {
        frag_color = vec4(original.rgb, 1.0 / MIN_HISTORY_BLEND_RATE);
        frag_motion = vec4(0.0);
        return;
    }
    vec3 current = tonemap(original.rgb);
    bool reverse = u_taa.y > 0.5;

    // The nearest depth of five taps (Karis 2014, slide 27): moving edges
    // take the foreground's motion.
    vec2 offset = texel * 2.0;
    vec2 closest_uv = uv;
    float closest = depth_at(uv);
    // Element by element, not an array constructor: Mali's compiler gives
    // the constructor's temporary no default precision and rejects it
    // (S0032, Mali-G57 under ANGLE).
    vec2 taps[4];
    taps[0] = uv + vec2(-offset.x, offset.y);
    taps[1] = uv + vec2(offset.x, offset.y);
    taps[2] = uv + vec2(-offset.x, -offset.y);
    taps[3] = uv + vec2(offset.x, -offset.y);
    for (int i = 0; i < 4; i++) {
        float d = depth_at(taps[i]);
        if (reverse ? d > closest : d < closest) {
            closest = d;
            closest_uv = taps[i];
        }
    }

    // Its motion since last frame, unjittered: a moving mesh's own, else
    // the camera's (where the point seen there, without this frame's
    // jitter, was last frame).
    vec2 motion = vec2(1000.0);
    if (u_taa.z > 0.5) {
        ivec2 at = clamp(ivec2(closest_uv * size), ivec2(0), ivec2(size) - 1);
        motion = texelFetch(u_velocity, at, 0).xy;
    }
    if (motion.x > 100.0) {
        vec3 ndc = vec3(closest_uv * 2.0 - 1.0 - u_jitter, reverse ? closest : closest * 2.0 - 1.0);
        vec4 prev = u_reproject * vec4(ndc, 1.0);
        vec2 prev_uv = prev.xy / prev.w * 0.5 + 0.5;
        motion = (closest_uv - 0.5 * u_jitter) - prev_uv;
    }

    vec2 history_uv = uv - motion;
    vec3 history = history_catmull_rom(history_uv, size);

    // Whether this pixel is seen through a transmissive or transparent
    // surface (FSR2's autogenerated reactivity: |post − pre| tonemapped,
    // over a threshold), and whether it holds still.
    float through = 0.0;
    if (u_reactive.x > 0.5) {
        vec3 delta = abs(current - tonemap(texelFetch(u_opaque, px, 0).rgb));
        through = max3(delta) * REACTIVE_SCALE < REACTIVE_THRESHOLD ? 0.0 : 1.0;
    }
    vec2 pixel_motion = abs(motion) * size;
    bool still = pixel_motion.x < 0.01 && pixel_motion.y < 0.01;

    // Clipped to the 3×3 neighborhood's spread in YCoCg (Salvi 2016).
    vec3 m1 = vec3(0.0);
    vec3 m2 = vec3(0.0);
    for (int y = -1; y <= 1; y++) {
        for (int x = -1; x <= 1; x++) {
            vec3 s = (x == 0 && y == 0) ? rgb_to_ycocg(current) : sample_current(px + ivec2(x, y));
            m1 += s;
            m2 += s * s;
        }
    }
    vec3 mean = m1 / 9.0;
    vec3 sd = sqrt(max(m2 / 9.0 - mean * mean, vec3(0.0)));
    // Through glass and still, a wider box: what refracts there jumps
    // with the jitter (the normal under each subpixel sample turns the
    // ray), and a box that tight would drag the history with it, flicker.
    // The history is right there: it averages the jumps out.
    if (still && u_reactive.y < 0.5) sd *= mix(1.0, GLASS_STILL_BOX, through);
    history = ycocg_to_rgb(clip_towards_aabb_center(rgb_to_ycocg(history), mean - sd, mean + sd));

    // Confidence grows while the pixel holds still, resets when it moves.
    float confidence = texelFetch(u_history, px, 0).a;
    confidence = still ? min(confidence + 10.0, 1000.0) : 1.0;
    float factor = clamp(1.0 / confidence, MIN_HISTORY_BLEND_RATE, DEFAULT_HISTORY_BLEND_RATE);
    // Reactive: how much a transmissive or transparent surface changed the
    // opaque scene here (FSR2: |post − pre| tonemapped, thresholded to a
    // binary value). It takes from the history's weight (FSR2's
    // accumulation × (1 − reactive)) where the history may be off: the
    // pixel moves, or such a mesh moved. Still, the history is right and
    // smooths them as anything else.
    if (!still || u_reactive.y > 0.5) {
        float reactive = through * REACTIVE_BINARY;
        factor = mix(factor, 1.0, reactive);
        confidence = reactive > 0.0 ? 1.0 : confidence;
    }
    // Disocclusion: the history's pixel moved otherwise last frame.
    ivec2 then = clamp(ivec2(history_uv * size), ivec2(0), ivec2(size) - 1);
    vec2 prev_motion = texelFetch(u_prev_motion, then, 0).xy;
    float disocclusion = (length((prev_motion - motion) * size) - DISOCCLUSION_THRESHOLD) * DISOCCLUSION_SCALE;
    if (disocclusion > 0.0) {
        factor = min(factor + disocclusion, 1.0);
        confidence = 1.0;
    }
    frag_motion = vec4(motion, 0.0, 0.0);
    // History from off screen: none to use.
    if (any(notEqual(clamp(history_uv, 0.0, 1.0), history_uv))) {
        factor = 1.0;
        confidence = 1.0;
    }
    current = mix(history, current, factor);
    frag_color = vec4(reverse_tonemap(current), confidence);
}
